---
import { Icon } from "astro-icon/components";
import type { Contact } from "@type/cv";

interface Props {
  contacts: Contact[];
}

const { contacts } = Astro.props;

function getHref(contact: Contact): string | undefined {
  if (contact.type === "location") return undefined;
  if (contact.type === "email") return `mailto:${contact.value}`;
  if (contact.type === "phone") return `tel:${contact.value}`;
  return contact.value;
}

function getDisplayValue(contact: Contact): string {
  if (contact.type === "telegram") {
    return contact.value.replace(/^https?:\/\/t\.me\//, "").replace(/\/$/, "");
  }

  if (contact.type === "github") {
    return contact.value
      .replace(/^https?:\/\/(?:www\.)?github\.com\//, "")
      .replace(/\/$/, "");
  }

  return contact.type === "website"
    ? contact.value.replace(/^https?:\/\//, "").replace(/\/$/, "")
    : contact.value;
}

function getIconName(contact: Contact): string {
  const icons = {
    email: "carbon:email",
    phone: "carbon:phone",
    location: "carbon:location",
    website: "fa6-solid:globe",
    github: "fa6-brands:github",
    telegram: "fa6-brands:telegram",
  } as const;

  return icons[contact.type];
}
---

<address class="cv-contact-row">
  {
    contacts.map((contact) => {
      const href = getHref(contact);
      const displayValue = getDisplayValue(contact);
      const iconName = getIconName(contact);

      return (
        <span class="cv-contact-item">
          {href ? (
            <a
              class="cv-contact-content"
              href={href}
              target={href.startsWith("http") ? "_blank" : undefined}
              rel={href.startsWith("http") ? "noopener noreferrer" : undefined}
            >
              <Icon name={iconName} class="cv-contact-icon" />
              {displayValue}
            </a>
          ) : (
            <span class="cv-contact-content">
              <Icon name={iconName} class="cv-contact-icon" />
              {displayValue}
            </span>
          )}
        </span>
      );
    })
  }
</address>
