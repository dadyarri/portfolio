---
import CVContact from "@components/CVContact.astro";
import type { CVData } from "@type/cv";

interface Props {
  data: CVData["personalInfo"];
  contacts: CVData["contactInfo"];
}

const { data, contacts } = Astro.props;
const { name, title, photo, summary } = data;
---

<div class="cv-hero">
  <div class="cv-hero-body cv-flow">
    <p class="cv-eyebrow">{title}</p>
    <h1 class="cv-hero-title">{name}</h1>
    <CVContact contacts={contacts} />
    {summary && <p class="cv-muted cv-hero-summary">{summary}</p>}
  </div>
  {
    photo && (
      <div class="cv-hero-photo">
        <img src={photo} alt={`${name}'s photo`} />
      </div>
    )
  }
</div>
